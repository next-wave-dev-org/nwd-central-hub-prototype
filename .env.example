# Supabase
# Find these in your Supabase project under: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
# Service role key — never expose this to the client. Used only in server actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend email provider
RESEND_API_KEY=

# Local app URL used in email links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Direct Postgres connection (Settings → Database → Connection string → URI).
# Optional — only needed to run scripts/run-sql.mjs (npm run db:exec) for
# applying migrations / ad hoc queries from the CLI instead of the SQL editor.
# Never commit the real value.
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres